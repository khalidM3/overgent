.DS_Store
.env
.env.*
!.env.example
node_modules/
.pnpm-store/
dist/
coverage/
*.log
coordination-eval-report.json

# Disposable/local Convex deployment state. The function bindings under
# convex/functions/_generated are checked in so fresh clones can typecheck
# without a deployment credential.
.convex/
convex/_generated/

# Build artifacts.
/bin/
/release/dist/

# Local build artifacts from go build ./validation/...
/coordination

# Desktop build output, including the downloaded Convex backend binary and the
# deploy payload generated at release time. Both are large, both are derived
# from scripts/backend-version.json and the tagged commit, and GoReleaser
# refuses to run against a dirty tree.
/apps/desktop/build/

# Notarized desktop archive staged by the release workflow before it is
# uploaded. GoReleaser refuses to run against a dirty tree, so leaving this
# untracked aborted the release after the build and notarization had already
# succeeded.
/dist-desktop/

# Staged closed-test distribution (install/dogfood/publish.sh).
/dist-dogfood/
/.vercel/
