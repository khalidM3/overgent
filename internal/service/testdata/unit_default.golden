# Generated by "overgent service install". Edits are replaced on the next
# install; change the profile instead.
[Unit]
Description=Overgent coordination service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart="/home/example/.local/bin/overgent" "--config-root" "/home/example/.config/Overgent" "service" "run"
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=15

[Install]
WantedBy=default.target
