{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.overgent.com/v1/finding.schema.json",
  "title": "Finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "severity", "confidenceBand", "workstreamIds", "evidence", "reason", "state", "revision"],
  "properties": {
    "id": {"type": "string", "pattern": "^fnd_[A-Za-z0-9_-]{1,80}$"},
    "kind": {"enum": ["direct_collision", "likely_collision", "redundant_work", "shared_dependency", "assumption_conflict", "downstream_impact", "stale_assumption", "dependency_ready"]},
    "severity": {"enum": ["low", "medium", "high", "critical"]},
    "confidenceBand": {"enum": ["deterministic", "high", "medium", "low"]},
    "workstreamIds": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string"}},
    "evidence": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/evidence"}},
    "reason": {"type": "string", "minLength": 1, "maxLength": 500},
    "state": {"enum": ["open", "acknowledged", "snoozed", "resolved", "dismissed"]},
    "revision": {"type": "integer", "minimum": 1}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "summary", "source", "fidelity"],
      "properties": {
        "kind": {"enum": ["path", "symbol", "claim", "dependency", "schema", "route", "lexical", "semantic", "decision"]},
        "summary": {"type": "string", "maxLength": 500},
        "source": {"type": "string", "maxLength": 80},
        "fidelity": {"type": "string", "maxLength": 80},
        "contract": {"$ref": "#/$defs/contractEvidence"},
        "dependency": {"$ref": "#/$defs/dependencyEvidence"}
      }
    },
    "dependencyEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "satisfiedByWorkstreamId", "satisfiedBy", "state"],
      "properties": {
        "claim": {"type": "string", "minLength": 1, "maxLength": 160},
        "satisfiedByWorkstreamId": {"type": "string", "minLength": 1, "maxLength": 128},
        "satisfiedBy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "symbols"],
          "properties": {
            "path": {"type": "string", "minLength": 1, "maxLength": 512},
            "symbols": {"type": "array", "maxItems": 200, "items": {"type": "string", "minLength": 1, "maxLength": 200}}
          }
        },
        "state": {"enum": ["stable_wip", "ready"]}
      }
    },
    "contractEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "changedSymbols", "changedByWorkstreamId", "readAt", "changedAt"],
      "properties": {
        "readFidelity": {"enum": ["observed", "vendor_inferred", "self_declared"]},
        "path": {"type": "string", "minLength": 1, "maxLength": 512},
        "changedSymbols": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "oldSignature", "newSignature"],
            "properties": {
              "name": {"type": "string", "minLength": 1, "maxLength": 200},
              "oldSignature": {"type": "string", "maxLength": 500},
              "newSignature": {"type": "string", "maxLength": 500}
            }
          }
        },
        "changedByWorkstreamId": {"type": "string", "minLength": 1, "maxLength": 128},
        "readAt": {"type": "string", "format": "date-time"},
        "changedAt": {"type": "string", "format": "date-time"}
      }
    }
  }
}
