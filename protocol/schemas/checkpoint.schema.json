{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.overgent.com/v1/checkpoint.schema.json",
  "title": "Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["checkpointId", "workstreamId", "summary", "observedAt"],
  "properties": {
    "checkpointId": {"type": "string", "pattern": "^chk_[A-Za-z0-9_-]{1,80}$"},
    "workstreamId": {"type": "string"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
    "discoveries": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 300}},
    "manifestRevision": {"type": "integer", "minimum": 1},
    "basedOnBriefId": {"type": "string"},
    "observedAt": {"type": "string", "format": "date-time"},
    "verification": {"type": "array", "maxItems": 32, "items": {"$ref": "verification.schema.json"}}
  }
}
