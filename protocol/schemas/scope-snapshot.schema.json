{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.overgent.com/v1/scope-snapshot.schema.json",
  "title": "ScopeSnapshot",
  "description": "A revisioned, deterministic answer to what one workstream is doing, and what it set out to do before that. Text is rendered only from the listed canonical facts. A managed model may improve wording from those facts, but may never ingest an agent transcript or change provenance, evidence quality, state, or meaning.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision",
    "state",
    "goal",
    "now",
    "done",
    "waitingOn",
    "verification",
    "scope",
    "priorGoals",
    "priorGoalsDropped"
  ],
  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "enum": [
        "implementing",
        "verifying",
        "waiting",
        "idle",
        "complete"
      ]
    },
    "goal": {
      "$ref": "#/$defs/field"
    },
    "now": {
      "$ref": "#/$defs/field"
    },
    "done": {
      "$ref": "#/$defs/field"
    },
    "waitingOn": {
      "$ref": "#/$defs/field"
    },
    "verification": {
      "$ref": "#/$defs/field"
    },
    "scope": {
      "$ref": "#/$defs/field"
    },
    "priorGoals": {
      "description": "Goals this session pursued and moved on from, oldest first, so completed work stays attached to the goal it belonged to. A session is not one task: an objective is restated, an agent proposes something adjacent, and work accumulates past the goal on record. Carrying only the current goal made `done` and `goal` drift apart until the list of finished work mostly did not belong to the goal displayed beside it. Bounded, and `priorGoalsDropped` counts what fell off the front rather than letting the list imply it is complete.",
      "type": "array",
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "endedAt"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "intendedOutcome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "endedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "priorGoalsDropped": {
      "description": "How many earlier goals were discarded to keep priorGoals bounded. Present so a truncated history never reads as a whole one.",
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "provenance",
        "evidenceQuality",
        "facts"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "provenance": {
          "enum": [
            "declared",
            "observed",
            "fallback",
            "unavailable"
          ]
        },
        "evidenceQuality": {
          "enum": [
            "high",
            "medium",
            "low",
            "none"
          ]
        },
        "facts": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "enum": [
              "intent.intendedOutcome",
              "intent.approachSummary",
              "intent.components",
              "intent.contracts",
              "intent.waitingOn",
              "activity.currentAction",
              "activity.writes",
              "activity.subagents",
              "contract.fingerprints",
              "checkpoint.verification",
              "session.derivedTitle"
            ]
          }
        }
      }
    }
  }
}
