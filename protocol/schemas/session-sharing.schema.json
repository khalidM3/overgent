{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overgent.com/schemas/session-sharing.schema.json",
  "title": "Session sharing snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["workstreamId", "messages"],
  "properties": {
    "workstreamId": { "$ref": "#/$defs/id" },
    "messages": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/message" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,127}$" },
    "messageKind": { "enum": ["user", "assistant", "thinking", "system"] },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "text", "vendor", "capturedAt", "expiresAt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "$ref": "#/$defs/messageKind" },
        "text": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "vendor": { "enum": ["codex", "claude"] },
        "capturedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
